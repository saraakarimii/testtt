# Docker Compose
POSTGRES_PASSWORD=change-me
APP_PORT=3000
MAX_UPLOAD_MB=25
# Optional: enables AI background segmentation (bg_mode=ai)
GEMINI_API_KEY=

# Local dev (npm run dev) — connect to your own Postgres
SQL_HOST=localhost
SQL_DB_NAME=chromabook
SQL_USER=chromabook
SQL_PASSWORD=change-me
SQL_ADMIN_USER=chromabook
SQL_ADMIN_PASSWORD=change-me
CHROMABOOK_DATA_DIR=./var
PORT=3000
